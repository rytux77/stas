
local Players = game:GetService("Players")


local function kickSelf()
    local player = Players.LocalPlayer
    if player then
        player:Kick("Fusion Hub\n\nUpdating Please Kindly Wait Until Next Update , in discord.")
    end
end


local function kickSpecificPlayer(username)
    local player = Players:FindFirstChild(username)
    if player then
        player:Kick("Fusion Hub\n\nUpdating Please Kindly Wait Until Next Update , in discord.")
        print("Kicked player: " .. username)
    else
        print("Player not found: " .. username)
    end
end


local function kickAllPlayers()
    for _, player in pairs(Players:GetPlayers()) do
        player:Kick("Fusion Hub\n\nUpdating Please Kindly Wait Until Next Update , in discord.")
    end
    print("Kicked all players")
end


